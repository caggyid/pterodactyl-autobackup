# CaggyID Pterodactyl Backup - environment overrides
# Copy to .env and adjust values. Values here override config.yaml.
# WARNING: never commit .env or credentials.json to version control.

# Comma-separated list of backup source directories
CAGGY_BACKUP_SOURCES=/var/lib/pterodactyl/volumes

# Path to the YAML configuration file
CAGGY_CONFIG=/etc/caggy-backup/config.yaml

# Google Drive OAuth files
CAGGY_CREDENTIALS_FILE=/etc/caggy-backup/credentials.json
CAGGY_TOKEN_FILE=/etc/caggy-backup/token.json

# Google Drive target folder name
CAGGY_GDRIVE_FOLDER=CaggyID-Backups

# Log directory and level (INFO|WARNING|ERROR|DEBUG)
CAGGY_LOG_DIRECTORY=/var/log/caggy-backup
CAGGY_LOG_LEVEL=INFO
